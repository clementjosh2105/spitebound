# Built-in accounts/leaderboards work without any variables.
# Required for free Cloudflare Pages hosting: set BOTH public Supabase values.
# They are public frontend configuration. Never use a secret/service-role key.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Optional server settings (not VITE variables; never exposed to browsers).
# TROLL_DB_PATH=/private/persistent/troll.sqlite
# PORT=8080
# HOST=0.0.0.0
# NODE_ENV=production
