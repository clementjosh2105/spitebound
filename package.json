{
  "name": "spitebound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --import tsx tests/progress.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "playwright test",
    "start": "node server/start.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && wrangler pages deploy dist --project-name spitebound --branch main"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "phaser": "^3.90.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
